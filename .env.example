# Copy to .env. Keep the key on the backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Cloud SQL via local Auth Proxy (port 5433). Provisioner can populate DB_PASSWORD.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=openclass
DB_USER=openclass
DB_PASSWORD=
# Per API process; ADK conversation sessions have their own small pool.
DB_POOL_MIN=2
DB_POOL_MAX=6
# A2A JSON-RPC 0.3 + authenticated task completion webhooks.
# Demo mode generates an ignored deployment/a2a.local.json service secret if empty.
A2A_SHARED_SECRET=
A2A_ASSESSMENT_URL=http://127.0.0.1:8000/a2a/assessment
A2A_CALLBACK_URL=http://127.0.0.1:8000/api/a2a/webhook
A2A_MAX_CONCURRENCY=3
CLOUD_SQL_CONNECTION_NAME=hackathon-506016:us-central1:openclass-postgres
OPENCLASS_DEMO=true
OPENCLASS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_TIMEOUT_SECONDS=90
# Managed Google services require ADC/Agent Identity, independently of the Gemini API key.
GOOGLE_CLOUD_PROJECT=hackathon-506016
GOOGLE_CLOUD_QUOTA_PROJECT=hackathon-506016
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false
GEAP_MEMORY_ENABLED=false
GEAP_MEMORY_BANK_ID=
MODEL_ARMOR_ENABLED=false
MODEL_ARMOR_TEMPLATE=
# Turn on in cloud to require memory and Model Armor; no silent fallback.
OPENCLASS_REQUIRE_GOVERNANCE=false
# MCP server: set a random secret of at least 32 characters, shared only with trusted API.
MCP_CONTEXT_SECRET=
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
GEAP_AGENT_GATEWAY=
GEAP_MCP_SERVER=
# Optional separate PostgreSQL SQLAlchemy URL for durable ADK sessions.
ADK_SESSION_DATABASE_URL=
# Chat history remains in PostgreSQL; opt in only if every graph checkpoint is needed.
ADK_PERSIST_INTERACTIVE_CHECKPOINTS=false

# Separate read-only MCP services. Leave disabled until both services are running.
DATA_MCP_ENABLED=false
DATA_MCP_URL=http://127.0.0.1:8001/mcp
GITHUB_MCP_ENABLED=false
GITHUB_MCP_URL=http://127.0.0.1:8002/mcp
# Only the GitHub MCP process should receive this token in cloud deployments.
GITHUB_UPSTREAM_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_PERSONAL_ACCESS_TOKEN=
# Local = in-process policy checks. Managed = signed workload identities required.
OPENCLASS_GOVERNANCE_MODE=local
OPENCLASS_AGENT_EXECUTION=local
# Managed: exact deployed SPIFFE subjects mapped by agent alias; never caller headers.
OPENCLASS_WORKLOAD_PRINCIPALS=
OPENCLASS_IDENTITY_ISSUER=
OPENCLASS_IDENTITY_AUDIENCE=https://openclass.internal/workloads
OPENCLASS_AGENT_URLS=
# API-only RSA private key; MCP/runtime containers receive ONLY the public key.
# Secret Manager-injected PEM values, not literal escaped newlines.
MCP_SCOPE_PRIVATE_KEY=
MCP_SCOPE_PUBLIC_KEY=
# Standard Cloud Run service audiences for the separated MCP services.
DATA_MCP_AUDIENCE=
GITHUB_MCP_AUDIENCE=
